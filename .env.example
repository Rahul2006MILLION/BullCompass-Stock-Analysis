APP_NAME=BullCompass
MODEL_NAME=qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434

# Market Data Provider ("angelone", "dhan", "live", "yfinance")
MARKET_DATA_PROVIDER=angelone

# Angel One SmartAPI Credentials (Environment variables)
ANGELONE_API_KEY=your_angelone_api_key_here
ANGELONE_CLIENT_ID=your_angelone_client_id_here
ANGELONE_PASSWORD=your_angelone_password_or_pin_here
ANGELONE_TOTP_SECRET=your_angelone_totp_secret_here

# Optional Alternative Providers
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# Cache configuration
QUOTE_CACHE_TTL_SECONDS=8
